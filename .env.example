# =============================================================================
# MHRAS Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# ── Database ────────────────────────────────────────────────────────────────
# Option 1: Full connection URL (takes priority over individual fields).
#   Supports PostgreSQL, SQLite, and Heroku-style postgres:// URLs.
#   Leave blank to fall back to Option 2 or the default SQLite file.
DATABASE_URL=

# Option 2: Individual PostgreSQL credentials (used when DATABASE_URL is empty).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mhras
DB_USER=mhras_user
DB_PASSWORD=
DB_POOL_SIZE=10

# ── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=5

# ── Security ────────────────────────────────────────────────────────────────
SECURITY_JWT_SECRET=change-me-in-production
SECURITY_JWT_ALGORITHM=HS256
SECURITY_JWT_EXPIRY_HOURS=24
SECURITY_ANONYMIZATION_SALT=change-me-in-production

# ── ML / Model ──────────────────────────────────────────────────────────────
ML_MODEL_STORAGE_PATH=models/
ML_INFERENCE_TIMEOUT=2
ML_RISK_THRESHOLD_HIGH=51.0
ML_RISK_THRESHOLD_CRITICAL=75.0

# ── Governance ──────────────────────────────────────────────────────────────
GOVERNANCE_HUMAN_REVIEW_THRESHOLD=75.0
GOVERNANCE_REVIEW_ESCALATION_HOURS=4
GOVERNANCE_AUDIT_LOG_RETENTION_DAYS=90
GOVERNANCE_DRIFT_THRESHOLD=0.3

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_OUTPUT=stdout

# ── General ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
