# =============================================================================
# MHRAS Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# ── Firebase ───────────────────────────────────────────────────────────────
# Public Firebase web settings used by the browser sign-in buttons.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Option 1: Path to a service-account JSON file (local development)
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Option 2: Inline JSON string (Railway, Vercel, or other PaaS)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"mental-696ef",...}

# ── Security ────────────────────────────────────────────────────────────────
SECURITY_JWT_SECRET=
SECURITY_ANONYMIZATION_SALT=
SECURITY_DATA_ENCRYPTION_KEY=
REQUIRE_ADMIN_MFA=true
# Comma-separated Firebase UIDs used only by scripts/bootstrap_roles.py
ADMIN_BOOTSTRAP_UIDS=

# ── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_TIMEOUT=5

# ── ML / Model ──────────────────────────────────────────────────────────────
ML_RISK_THRESHOLD_HIGH=51.0
ML_RISK_THRESHOLD_CRITICAL=75.0

# Ollama (for AI-generated clinical explanations)
ML_OLLAMA_BASE_URL=http://localhost:11434
ML_OLLAMA_MODEL=llama3
ML_OLLAMA_API_KEY=
ML_OLLAMA_TIMEOUT=30

# ── Governance ──────────────────────────────────────────────────────────────
GOVERNANCE_HUMAN_REVIEW_THRESHOLD=75.0
GOVERNANCE_SCREENING_RETENTION_DAYS=90
GOVERNANCE_AUDIT_LOG_RETENTION_DAYS=90

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_OUTPUT=stdout

# ── General ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
