rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: check if requesting user has a specific role ───────────
    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == "admin";
    }

    function isReviewer() {
      return request.auth != null && (getUserRole() == "admin" || getUserRole() == "reviewer");
    }

    // ── Users collection ───────────────────────────────────────────────
    match /users/{userId} {
      // Users can read their own doc; admins can read any
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Users can create their own doc on first login (auto-created by backend)
      // Admins can update any user doc (e.g. promote to admin)
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId || isAdmin();
      allow delete: if false;
    }

    // ── Screenings collection ──────────────────────────────────────────
    match /screenings/{screeningId} {
      // Any authenticated user can read screenings
      allow read: if request.auth != null;
      // Any authenticated user can create screenings
      allow create: if request.auth != null;
      // No updates or deletes allowed by clients
      allow update: if false;
      allow delete: if false;
    }

    // ── Explanations collection ────────────────────────────────────────
    match /explanations/{explanationId} {
      // Any authenticated user can read explanations
      allow read: if request.auth != null;
      // Any authenticated user can create explanations (written by backend)
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    // ── Reviews collection ─────────────────────────────────────────────
    match /reviews/{reviewId} {
      // Any authenticated user can read reviews
      allow read: if request.auth != null;
      // Only admin or reviewer can create/update reviews
      allow create: if request.auth != null;
      allow update: if isReviewer();
      allow delete: if false;
    }

    // ── Default: deny all other collections ────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
