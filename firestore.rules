rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: check if requesting user has a specific role ───────────
    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == "admin";
    }

    function isReviewer() {
      return request.auth != null && (getUserRole() == "admin" || getUserRole() == "reviewer");
    }

    // ── Users collection ───────────────────────────────────────────────
    match /users/{userId} {
      // Users can read their own doc; admins can read any
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Users can create their own doc on first login
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if false;
    }

    // ── Screenings collection ──────────────────────────────────────────
    match /screenings/{screeningId} {
      // Users can only read screenings created by themselves (user_id field), admins/reviewers read all
      allow read: if request.auth != null && (resource.data.user_id == request.auth.uid || isReviewer());
      // Users can only create screenings stamped with their own uid
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // ── Explanations collection ────────────────────────────────────────
    match /explanations/{explanationId} {
      // Users can only read explanations belonging to their own screenings, admins/reviewers read all
      allow read: if request.auth != null && (resource.data.user_id == request.auth.uid || isReviewer());
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // ── Reviews collection ─────────────────────────────────────────────
    match /reviews/{reviewId} {
      // Users can read reviews of their own screenings; admins/reviewers can read all
      allow read: if request.auth != null && (resource.data.user_id == request.auth.uid || isReviewer());
      allow create: if request.auth != null;
      allow update: if isReviewer();
      allow delete: if false;
    }

    // ── Default: deny all other collections ────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
