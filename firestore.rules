rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: check if requesting user has a specific role ───────────
    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == "admin";
    }

    // ── Users collection ───────────────────────────────────────────────
    // Strict isolation: users can ONLY read/write their own doc.
    // Admins can read any user doc (e.g. to map uid → email for triage).
    // Nobody can list all users client-side; listing happens via backend.
    match /users/{userId} {
      allow read:   if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Screenings collection ──────────────────────────────────────────
    // Users can ONLY read screenings where user_id == their uid.
    // Admins can read all.
    // Create: any authenticated user, but they MUST stamp their own uid.
    match /screenings/{screeningId} {
      allow read:   if request.auth != null && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Explanations collection ────────────────────────────────────────
    // Same isolation rule as screenings.
    match /explanations/{explanationId} {
      allow read:   if request.auth != null && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Reviews collection ─────────────────────────────────────────────
    // Only admins can read/create/update reviews.
    // Non-admin users have ZERO access — their own screenings never appear here.
    match /reviews/{reviewId} {
      allow read:   if isAdmin();
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Default: deny all other collections ────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
