{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "legal.css", "use": "@vercel/static" },
    { "src": "terms.html", "use": "@vercel/static" },
    { "src": "privacy.html", "use": "@vercel/static" },
    { "src": "hipaa.html", "use": "@vercel/static" },
    { "src": "disclaimer.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api(?:/(.*))?", "dest": "api/index.py" },
    { "src": "/app.js", "dest": "/app.js" },
    { "src": "/styles.css", "dest": "/styles.css" },
    { "src": "/legal.css", "dest": "/legal.css" },
    { "src": "/terms.html", "dest": "/terms.html" },
    { "src": "/privacy.html", "dest": "/privacy.html" },
    { "src": "/hipaa.html", "dest": "/hipaa.html" },
    { "src": "/disclaimer.html", "dest": "/disclaimer.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
